# =============================================================================
# Hefesto Studio — VeterinariaHefesto
# =============================================================================
# Copie este archivo a `.env` y complete los valores.
#
# Este archivo NO tiene valores reales. Trae los que usan los servicios de
# despliegue (Caddy). Los secretos de la API estan en api/.env.example.
# =============================================================================

# Dominio publico de la instalacion.
# En desarrollo puede ser `localhost`; Caddy emite un certificado local.
DOMINIO=veterinaria.local

# Correo para los avisos de ACME (renovacion de certificados).
ACME_EMAIL=admin@ejemplo.local

# Direccion de la base de datos vista desde el host, si se necesita.
# En el despliegue de referencia PostgreSQL NO publica puertos: solo Caddy
# sale a internet. Ver docs/04.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=veterinaria
DB_USERNAME=veterinaria
DB_PASSWORD=cambie-esta-clave

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=veterinaria_admin
DB_ADMIN_PASSWORD=
