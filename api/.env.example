# =============================================================================
# Hefesto Studio — VeterinariaHefesto: API (Laravel)
# =============================================================================
# Copie este archivo a `.env` y complete los valores.
# NUNCA versione el `.env` con valores reales.
#
# ESTE ARCHIVO NO TIENE VALORES REALES
# -----------------------------------
# Todo lo que esta en blanco hay que completarlo antes de levantar la
# aplicacion. Donde hay un valor de ejemplo, es un ejemplo: cambielo.
# =============================================================================

APP_NAME=VeterinariaHefesto
# `local` en desarrollo, `production` en produccion.
APP_ENV=local
# En produccion tiene que ser `false`: el registro con nivel `debug` puede
# incluir datos de una peticion, y en una clinica eso incluye fichas.
APP_DEBUG=false
APP_TIMEZONE=America/Santiago
APP_URL=http://localhost:8000

APP_KEY=
# Generelo con: php artisan key:generate

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# PostgreSQL, obligatorio. La Row Level Security no existe en otro motor, y el
# aislamiento entre clinicas depende de ella. Ver docs/03.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=veterinaria
DB_USERNAME=veterinaria
DB_PASSWORD=cambie-esta-clave

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=veterinaria_admin
DB_ADMIN_PASSWORD=

DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Conexion para leer la sesion ANTES del contexto de clinica
# -----------------------------------------------------------------------------
# Aparte a proposito. `sesiones` tiene RLS, y el guard de sesion la lee antes
# de saber de que clinica es la peticion. Con el manejador de Laravel, esa
# lectura lanzaria excepcion y nadie podria entrar.
#
# El rol que se ponga aqui NO debe ser superusuario ni tener BYPASSRLS, y
# deberia tener SOLO permiso de lectura sobre `sesiones`.
# `clinica:verificar-aislamiento` lo comprueba.
#
# Ver docs/03 y App\Services\Auth\AlmacenDeSesion.
DB_SESIONES_HOST=postgres
DB_SESIONES_PORT=5432
DB_SESIONES_DATABASE=veterinaria
DB_SESIONES_USERNAME=
DB_SESIONES_PASSWORD=
DB_SESIONES_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Conexion de la bitacora de accesos a la ficha clinica
# -----------------------------------------------------------------------------
# Aparte a proposito: la peticion puede terminar revertida (acceso denegado) y
# el registro del intento tiene que sobrevivir. Puede apuntar a otra base,
# incluso a otra maquina. Ver docs/07.
DB_BITACORA_HOST=postgres
DB_BITACORA_PORT=5432
DB_BITACORA_DATABASE=veterinaria
DB_BITACORA_USERNAME=veterinaria
DB_BITACORA_PASSWORD=cambie-esta-clave
DB_BITACORA_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Redis (cache, sesiones y colas)
# -----------------------------------------------------------------------------
# Redis es la CACHE, no el almacen de sesiones: una sesion autoriza el acceso
# a una ficha clinica y no puede depender de algo que se pueda perder. Las
# sesiones viven en PostgreSQL. Ver config/session.php.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
# Minutos que dura una sesion abierta. En una clinica conviene poco: una sesion
# abierta mucho rato es una sesion abierta a la ficha clinica.
SESSION_EXPIRACION_MINUTOS=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Authentik (identidad de Hefesto)
# -----------------------------------------------------------------------------
# URL publica del emisor, SIN barra final. El descubrimiento OIDC se lee de
# `<AUTHENTIK_ISSUER>/.well-known/openid-configuration`.
AUTHENTIK_ISSUER=https://identidad.hefesto.cl
# Cliente OIDC EXCLUSIVO de esta aplicacion: asi se puede revocar el acceso a
# VeterinariaHefesto sin tocar las demas aplicaciones de Hefesto.
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
AUTHENTIK_SCOPES=openid profile email
AUTHENTIK_ALGORITMO=RS256
AUTHENTIK_CACHE_METADATA=3600
AUTHENTIK_CACHE_JWKS=86400
AUTHENTIK_LEEWAY=60
# Prefijo de los equipos de Authentik que declaran la clinica. El equipo se
# llama `<prefijo>:<correlacion>`, por ejemplo `VeterinariaHefesto:veterinaria-demo`.
# config/authentik.php trae el mapa de equipos por rol; hay que completarlo al
# instalar. Ver docs/05.
AUTHENTIK_GRUPO_POR_CLINICA=VeterinariaHefesto

# -----------------------------------------------------------------------------
# Reglas de la aplicacion
# -----------------------------------------------------------------------------
# Agenda.
VETERINARIA_DURACION_MAXIMA_MINUTOS=240
VETERINARIA_MARGEN_ENTRE_CITAS=0

# Vacunas. ATENCION: estos dos valores son reglas de TRABAJO, no reglas
# sanitarias. Ninguno de los dos dice que intervalo de vacunacion sea el
# correcto. Ver docs/07.
VETERINARIA_VENTANA_POR_VENCER_DIAS=30
VETERINARIA_DIAS_AVISO_ATRASO=60

# Mostrador. No cambiar a `true` sin una decision de la clinica: vender con
# stock negativo significa cobrar por algo que no habia.
VETERINARIA_PERMITIR_STOCK_NEGATIVO=false

# Conservacion y alertas.
# El plazo de retencion NO es una recomendacion juridica verificada: lo define
# la normativa aplicable y la politica de la institucion. Ver docs/07.
VETERINARIA_RETENCION_BITACORA_DIAS=3650
VETERINARIA_ALERTA_DENEGADOS_POR_HORA=20
VETERINARIA_ALERTA_DENEGADOS_POR_USUARIO=5
